# --- PostgreSQL ---
POSTGRES_DB=measurelog
POSTGRES_USER=admin
POSTGRES_PASSWORD=root

# --- Admin login (διαχειριστικό) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SECRET_KEY=please-change-this-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# --- CORS (κενό ή * για dev) ---
CORS_ORIGINS=*

# --- Storage (bind mount host path) ---
# Τοπικά (Windows/Mac/Linux dev):
MEASURELOG_DATA_DIR=./storage
# Στο Ubuntu server:
# MEASURELOG_DATA_DIR=/srv/measurelog

# --- Backups ---
BACKUP_HOUR=02
BACKUP_MINUTE=00
BACKUP_RETENTION_DAYS=7
BACKUP_ON_START=false
