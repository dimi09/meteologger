{
  "name": "meteologger-desktop",
  "productName": "MeteoLogger",
  "version": "1.0.0",
  "description": "MeteoLogger desktop client (βρίσκει αυτόματα τον server στο LAN)",
  "author": "Dimitris Misoulis",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "gr.uniwa.meteologger",
    "productName": "MeteoLogger",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "discovery.js",
      "ui/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "MeteoLogger-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MeteoLogger"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://meteologger.local/desktop/"
      }
    ]
  }
}
